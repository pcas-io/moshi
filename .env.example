# moshi.moshi — environment.
# Copy to .env (gitignored) and fill the three secrets.
# Generate each: openssl rand -hex 32

# Required, all modes. Min 32 chars. Empty/short = startup abort.
MESH_ADMIN_TOKEN=change-me-openssl-rand-hex-32

# Required in production (NODE_ENV=production), min 32 chars each.
# In dev they fall back to MESH_ADMIN_TOKEN with a loud warning.
MESH_COOKIE_SECRET=
OAUTH_SECRET=

# Enforces separate secrets above. MUST be set for any real deployment.
NODE_ENV=production

# Optional: the session cookie's Secure flag. Default follows NODE_ENV, so
# production means Secure. A browser drops a Secure cookie that arrives over
# plain http; Chrome and Firefox make an exception for http://localhost,
# Safari does not. Set 0 whenever the dashboard is served without TLS.
# MESH_COOKIE_SECURE=0

# Optional: previous admin token, accepted during a token rotation window.
# MESH_ADMIN_TOKEN_PREVIOUS=

# Infra (defaults shown; compose injects these — override only off-compose).
NATS_URL=nats://nats:4222
DATABASE_PATH=/data/moshi.db
# PORT=3000   # compose sets 80; default off-compose is 3000
