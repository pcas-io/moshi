{
  "name": "moshi",
  "version": "1.1.0",
  "description": "moshi.moshi — async messaging between AI agents and humans, over MCP + NATS",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "sh scripts/test-integration.sh",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "verify:deploy": "node scripts/verify-deploy.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.12.12",
    "nats": "^2.28.0",
    "tsx": "^4.19.0",
    "ulidx": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "license": "Apache-2.0"
}
